# ─────────────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
audit.log

# ─────────────────────────────────────────────────────────────────────────────
# 6. DADOS LOCAIS / RUNTIME
# ─────────────────────────────────────────────────────────────────────────────
backend/data/
backend/server/data/*.json
!backend/server/data/.gitkeep
backend/server/storage/
backend/storage/
storage/uploads/
uploads/
*.sqlite
*.sqlite3
*.db
*.db-journal

# Dumps e exports
*.dump
*.sql
*.bson
*.gz
mongodump/
mongo-backup/

# Excel / CSV / dados de teste
*.xlsx
*.xls
*.csv
*.tsv

# ─────────────────────────────────────────────────────────────────────────────
# 7. BACKUPS
# ─────────────────────────────────────────────────────────────────────────────
*.backup
*.bak
*-backup.*
*.old
*.orig
*.bundle
.gitignore.bak

# ─────────────────────────────────────────────────────────────────────────────
