# =============================================================================
#  OD DRIVE — .gitignore
#  Regra de ouro: NADA de credenciais, dumps, backups ou scripts locais no repo
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. SECRETS & CREDENCIAIS  (NUNCA commitar)
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample

# Chaves, certificados, tokens
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
*.crt
*.cer
*.der
*.csr
secrets/
**/secrets/
PARAMETROS SECRETOS/
**/PARAMETROS SECRETOS/
service-account*.json
*credentials*.json
*service-account*.json
google-credentials*.json
firebase-adminsdk*.json

# Tokens / cookies salvos
*.token
*token.txt
cookies.txt

# ─────────────────────────────────────────────────────────────────────────────
# 2. SCRIPTS LOCAIS COM CREDENCIAIS HARDCODED
# ─────────────────────────────────────────────────────────────────────────────
sync-api-to-mongo.mjs
reload-normalized.mjs
sync-oddrive-safe.ps1
sync-oddrive-safe*.ps1
LOGINS_maker*
sync-backups/
**/sync-backups/

# Scripts ad-hoc de teste de API
API_*.ps1
api-test-results.txt
api-analysis/
test-api-*.mjs
test-api-*.js
scratch.*
playground.*

# Artefatos legados AWS/CodeDeploy (Render é o deploy oficial)
_aws_temp/
_frontend_aws_temp/
appspec.yml
buildspec.yml
**/appspec.yml
**/buildspec.yml
mapeamento-database-cliente.txt

# ─────────────────────────────────────────────────────────────────────────────
# 3. DEPENDENCIES
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
yarn.lock
package-lock.json.bak

# ─────────────────────────────────────────────────────────────────────────────
# 4. BUILD ARTIFACTS
# ─────────────────────────────────────────────────────────────────────────────
dist/
dist-electron/
build/
out/
.next/
.nuxt/
.output/
.vercel/
.netlify/
coverage/
.nyc_output/
tmp/
temp/
.parcel-cache/
.cache/
.turbo/

# ─────────────────────────────────────────────────────────────────────────────
