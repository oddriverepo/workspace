PORT=3001
NODE_ENV=production
MONGO_URI=
MONGO_DB_NAME=odrive_app
FRONTEND_URL=

# Limites operacionais do processo no Render (os valores abaixo ja sao os padroes)
RENDER_MEMORY_LIMIT_MB=512
MEMORY_SOFT_LIMIT_MB=379
MEMORY_HARD_LIMIT_MB=440
WORKLOAD_HEAVY_CONCURRENCY=1
WORKLOAD_HEAVY_MAX_QUEUE=6
WORKLOAD_EXTERNAL_CONCURRENCY=2
WORKLOAD_EXTERNAL_MAX_QUEUE=12
MONGO_MAX_POOL_SIZE=8
MONGO_MIN_POOL_SIZE=0
CRM_APPS_SCRIPT_CACHE_TTL_MS=60000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# CRM Google Sheets via Apps Script Web App
CRM_APPS_SCRIPT_URL=
CRM_APPS_SCRIPT_SECRET=
CRM_APPS_SCRIPT_TIMEOUT_MS=20000

# GPT Maker CRM (somente leitura de chats/atendimentos; sem mensagens ou conteudo)
GPTMAKER_API_TOKEN=
GPTMAKER_WORKSPACE_ID=
# Opcional: limita a consulta a um unico agente
GPTMAKER_AGENT_ID=
GPTMAKER_TIMEOUT_MS=20000
GPTMAKER_CACHE_TTL_MS=90000
GPTMAKER_PAGE_SIZE=100
GPTMAKER_MAX_PAGES=50
# Opcional se o canal usar um tipo diferente do padrao
GPTMAKER_INSTAGRAM_TYPES_JSON=[]

# META ADS (somente leitura; token de usuario do sistema com ads_read)
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_IDS=act_2604221799864447
META_ADS_DEFAULT_ACCOUNT_ID=act_2604221799864447
META_ADS_API_VERSION=v25.0
META_ADS_TIMEOUT_MS=20000
META_ADS_CACHE_TTL_MS=90000
# JSON opcional: {"act_2604221799864447":"OD DRIVE Arthur"}
META_ADS_ACCOUNT_LABELS_JSON={}
# JSON opcional para nomes fora do padrao: {"campinas rm":"Campinas"}
META_ADS_CITY_ALIASES_JSON={}

DISABLE_RATE_LIMIT=0
TRUST_PROXY=1
SECRET_ENCRYPTION_KEY=

# ── API OdDrive (legado — REST via JWT; substituído pelo mirror direto) ──
ODDRIVE_API_URL=
ODDRIVE_API_EMAIL=
ODDRIVE_API_TOKEN=
ODDRIVE_API_PASSWORD=

# ── OdDrive live DB (fonte read-only do mirror de campanhas/motoristas) ──
ODDRIVE_DB_URI=
ODDRIVE_DB_NAME=ODDrive
ODDRIVE_FILIAL_ID=
MIRROR_ENABLED=0
MIRROR_INTERVAL_MIN=2

META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_BUSINESS_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v21.0
CAMPAIGN_SEND_LIMIT=1000
